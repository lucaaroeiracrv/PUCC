create table fabricante (
    codigo integer primary key,
    nome text not null,
    pais_de_origem text
);

create table modelo (
    codigo integer primary key,
    nome text not null,
    versao text,
    ano_inicio_producao integer,
    ano_fim_producao integer,
    preco_lancamento real,
    moeda text,
    fabricante integer not null,

    foreign key (fabricante) references fabricante(codigo)
);